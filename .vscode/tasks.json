{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Explorer++ (Debug x64)",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\Scripts\\build-debug.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"inAgents": true
		},
		{
			"label": "Build and Run Explorer++ (Debug x64, no debugger)",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\Scripts\\build-debug.ps1",
				"-Run"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"inAgents": true
		}
	]
}